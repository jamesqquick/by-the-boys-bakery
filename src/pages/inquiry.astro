---
import { getEmDashCollection } from "emdash";
import type { PricingItem, PricingOption } from "../../.emdash/types";
import BakeryLayout from "../layouts/BakeryLayout.astro";
import InquiryForm from "../components/InquiryForm";
import { makeInquiryPackages } from "../lib/inquiry-pricing";

const [
  { entries: items, error: itemsError, cacheHint: itemsHint },
  { entries: options, error: optionsError, cacheHint: optionsHint },
] = await Promise.all([
  getEmDashCollection("pricing_items", { status: "published", orderBy: { sort: "asc" } }),
  getEmDashCollection("pricing_options", { status: "published", orderBy: { sort: "asc" } }),
]);

if (itemsError || optionsError) throw itemsError ?? optionsError;
if (Astro.cache?.enabled) {
  Astro.cache.set(itemsHint);
  Astro.cache.set(optionsHint);
}

const packages = makeInquiryPackages(
  items.map((item) => item.data as PricingItem),
  options.map((option) => option.data as PricingOption),
);
---

<BakeryLayout
  title="Place an Inquiry"
  description="Choose your treats, see an estimated subtotal, and tell us what you'd like baked."
  currentPath="/inquiry"
>
  <!-- Page header -->
  <div class="page-header">
    <div class="page-header-content">
      <span class="page-eyebrow">Let's Make Something</span>
      <h1>Place an Inquiry</h1>
      <p class="page-header-desc">
        Pick your packages to see an estimate, or tell us about a custom request.
        We'll get back to you within 48 hours to confirm the details.
      </p>
    </div>
    <div class="page-header-aside">
      <h4>What happens next?</h4>
      <ul class="aside-list">
        <li>We review your inquiry</li>
        <li>We reach out within 48 hrs</li>
        <li>We confirm what we can do</li>
        <li>You get fresh baked goods</li>
      </ul>
    </div>
  </div>

  <!-- Form -->
  <div class="form-wrap">
    <InquiryForm packages={packages} client:load />
  </div>
</BakeryLayout>

<style is:global>
  /* ── Page Header ── */
  .page-header {
    background: var(--color-butter);
    border-bottom: 4px solid var(--color-choco);
    padding: 4rem 4rem 3.5rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: end;
  }

  .page-eyebrow {
    display: inline-block;
    background: var(--color-choco);
    color: var(--color-butter);
    padding: 0.35rem 0.85rem;
    border-radius: 100px;
    font-size: 0.72rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
  }

  .page-header h1 {
    font-family: var(--font-family-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--color-choco);
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .page-header-desc {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-muted);
    max-width: 480px;
    line-height: 1.7;
  }

  .page-header-aside {
    background: #fff;
    border: 3px solid var(--color-choco);
    box-shadow: var(--shadow-neo);
    border-radius: var(--radius-card);
    padding: 1.5rem 1.75rem;
    min-width: 220px;
    align-self: center;
  }

  .page-header-aside h4 {
    font-family: var(--font-family-display);
    font-size: 1rem;
    color: var(--color-choco);
    margin-bottom: 0.75rem;
  }

  .aside-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .aside-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-muted);
    line-height: 1.4;
  }

  .aside-list li::before {
    content: "✓";
    color: var(--color-mint);
    font-weight: 900;
    flex-shrink: 0;
  }

  /* ── Form wrapper ── */
  .form-wrap {
    max-width: 860px;
    margin: 0 auto;
    padding: 4rem 2rem 6rem;
  }

  /* ── InquiryForm card ── */
  .inquiry-form {
    background: #fff;
    border: 3px solid var(--color-choco);
    border-radius: 24px;
    box-shadow: var(--shadow-neo-lg);
    overflow: hidden;
  }

  .form-section {
    padding: 2.5rem 3rem;
    border-bottom: 3px solid var(--color-choco);
  }

  .form-section:last-of-type {
    border-bottom: none;
  }

  .form-section-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.72rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    margin-bottom: 1.75rem;
  }

  .form-section-label::before {
    content: attr(data-step);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: var(--color-butter);
    border: 2px solid var(--color-choco);
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: 900;
    color: var(--color-choco);
    flex-shrink: 0;
  }

  .field-row {
    display: grid;
    gap: 1.25rem;
  }

  .field-row.two-col {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }

  .field-hint {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-muted);
    line-height: 1.4;
  }

  /* shadcn Input / Textarea overrides */
  .inquiry-form input,
  .inquiry-form textarea {
    background: var(--color-cream);
    border: 3px solid var(--color-choco);
    border-radius: 12px;
    font-family: var(--font-family);
    font-weight: 700;
    color: var(--color-choco);
  }

  .inquiry-form input:focus,
  .inquiry-form textarea:focus {
    background: #fff;
    box-shadow: var(--shadow-neo-sm);
    outline: none;
  }

  .inquiry-form textarea {
    min-height: 120px;
    resize: vertical;
  }

  /* shadcn Label override */
  .inquiry-form label {
    font-size: 0.8rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-choco);
  }

  .required {
    color: var(--color-strawberry);
    margin-left: 2px;
  }

  .optional {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--color-muted);
    text-transform: none;
    letter-spacing: 0;
    margin-left: 4px;
  }

  .package-list {
    display: grid;
    gap: 1rem;
  }

  .package-group {
    padding: 1.25rem;
    background: var(--color-cream);
    border: 3px solid var(--color-choco);
    border-radius: 16px;
  }

  .package-group h3 {
    font-family: var(--font-family-display);
    font-size: 1.5rem;
  }

  .package-group > p {
    margin: 0.25rem 0 1rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-muted);
  }

  .package-option {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0;
    border-top: 2px solid var(--color-choco);
    font-weight: 800;
  }

  .package-option label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.125rem 0.65rem;
    margin-bottom: 0;
    text-transform: none;
    letter-spacing: normal;
  }

  .package-option .package-price {
    white-space: nowrap;
    font-weight: 800;
  }

  .package-stepper {
    display: grid;
    grid-template-columns: 2.75rem 3rem 2.75rem;
    border: 3px solid var(--color-choco);
    border-radius: 12px;
    overflow: hidden;
  }

  .package-option .package-stepper input {
    width: 100%;
    height: 2.75rem;
    padding: 0.25rem 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    appearance: textfield;
    text-align: center;
  }

  .package-option .package-stepper input::-webkit-inner-spin-button,
  .package-option .package-stepper input::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .package-option .package-stepper input:focus {
    box-shadow: none;
  }

  .package-option .package-stepper input:focus-visible {
    outline: 2px solid var(--color-strawberry);
    outline-offset: -2px;
  }

  .package-stepper button {
    width: 100%;
    min-width: 0;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: var(--color-butter);
    color: var(--color-choco);
    box-shadow: none;
    transform: none;
  }

  .package-stepper button:first-child {
    border-right: 2px solid var(--color-choco);
  }

  .package-stepper button:last-child {
    border-left: 2px solid var(--color-choco);
  }

  .package-stepper button:focus-visible {
    outline: 2px solid var(--color-strawberry);
    outline-offset: -3px;
  }

  .package-stepper button:not(:disabled):hover {
    background: var(--color-sky);
    box-shadow: none;
    transform: none;
  }

  .estimate {
    margin-top: 1.5rem;
    padding: 1.25rem;
    border: 3px solid var(--color-choco);
    border-radius: 16px;
    background: var(--color-sky);
    box-shadow: var(--shadow-neo-sm);
  }

  .estimate-total {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-weight: 900;
    font-size: 1.25rem;
  }

  .estimate p {
    margin-top: 0.5rem;
    color: var(--color-choco);
    font-size: 0.82rem;
    font-weight: 700;
  }

  /* Form footer */
  .form-footer {
    background: var(--color-butter);
    border-top: 3px solid var(--color-choco);
    padding: 2.5rem 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .form-footer-note {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-muted);
    line-height: 1.5;
    max-width: 340px;
  }

  .form-footer-note strong {
    color: var(--color-choco);
    font-weight: 900;
  }

  .submit-btn {
    flex-shrink: 0;
  }

  /* Success state */
  .form-success {
    padding: 4rem 3rem;
    text-align: center;
  }

  .success-title {
    font-family: var(--font-family-display);
    font-size: 2rem;
    color: var(--color-choco);
    margin-bottom: 0.75rem;
  }

  .success-body {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-muted);
    max-width: 400px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* ═══════════════════════════════════════
     RESPONSIVE
  ═══════════════════════════════════════ */

  /* ── Tablet ── */
  @media (max-width: 1023px) {
    .page-header {
      padding: 3rem 2.5rem 2.5rem;
      gap: 1.5rem;
    }

    .form-wrap {
      padding: 3rem 1.5rem 5rem;
    }

    .form-section {
      padding: 2rem 2rem;
    }

    .form-footer {
      padding: 2rem 2rem;
    }

    .form-success {
      padding: 3rem 2rem;
    }
  }

  /* ── Mobile ── */
  @media (max-width: 767px) {
    /* Page header: single column */
    .page-header {
      grid-template-columns: 1fr;
      padding: 2rem 1.5rem;
      gap: 1.5rem;
      align-items: start;
    }

    .page-header h1 {
      font-size: clamp(2rem, 9vw, 2.75rem);
      margin-bottom: 0.5rem;
    }

    .page-header-aside {
      min-width: 0;
      width: 100%;
    }

    /* Form wrapper */
    .form-wrap {
      padding: 1.5rem 1rem 4rem;
    }

    /* Form card: tighter on small screens */
    .inquiry-form {
      border-radius: 16px;
    }

    .form-section {
      padding: 1.5rem 1.25rem;
    }

    /* Two-col fields → single column */
    .field-row.two-col {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Form footer: stack vertically */
    .form-footer {
      flex-direction: column;
      align-items: stretch;
      padding: 1.5rem 1.25rem;
      gap: 1.25rem;
    }

    .form-footer-note {
      max-width: 100%;
    }

    .submit-btn {
      width: 100%;
    }

    .form-success {
      padding: 2.5rem 1.5rem;
    }
  }

  @media (max-width: 359px) {
    .package-option {
      grid-template-columns: minmax(0, 1fr);
    }

    .package-option .package-stepper {
      justify-self: end;
    }
  }

  .field-error {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-strawberry);
    margin-top: 0.35rem;
    line-height: 1.4;
  }
</style>
