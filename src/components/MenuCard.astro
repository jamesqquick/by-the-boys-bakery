---
import { Image } from "emdash/ui";
import type { MediaValue } from "emdash";

interface Props {
  name: string;
  description?: string;
  image?: MediaValue;
}

const { name, description, image } = Astro.props;
---

<div class="menu-card">
  {image ? (
    <div class="menu-card-img">
      <Image image={image} alt={image?.alt ?? name} class="menu-card-img-media" />
    </div>
  ) : (
    <div class="menu-card-img menu-card-img--empty"></div>
  )}
  <div class="menu-card-body">
    <h3 class="menu-card-name">{name}</h3>
    <p class="menu-card-desc">{description}</p>
  </div>
</div>

<style>
  .menu-card {
    background: #fff;
    border: 3px solid var(--color-choco);
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-neo);
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .menu-card:hover {
    transform: translate(-4px, -4px);
    box-shadow: var(--shadow-neo-lg);
  }

  .menu-card-img {
    width: 100%;
    aspect-ratio: 1/1;
    overflow: hidden;
    border-radius: 0;
  }

  .menu-card-img--empty {
    background: var(--color-sky);
    border-bottom: 3px solid var(--color-choco);
  }

  /* Image component renders in a child component, so the class it's given
     lands outside this file's scoped styles — use :global to reach it. */
  :global(.menu-card-img-media) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .menu-card-body {
    padding: 1.25rem;
    border-top: 3px solid var(--color-choco);
  }

  .menu-card-name {
    font-family: var(--font-family-display);
    font-size: 1rem;
    color: var(--color-choco);
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }

  .menu-card-desc {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-muted);
    line-height: 1.5;
  }
</style>
