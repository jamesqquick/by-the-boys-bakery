---
import LocalImg from "../LocalImg.astro";
---

<section class="hero">
  <!-- Left: content -->
  <div class="hero-left">
    <div class="hero-location-pill">Germantown, TN</div>
    <h1 class="hero-title">
      Homemade<br />
      treats from<br />
      <span class="red">the boys!</span>
    </h1>
    <p class="hero-desc">
      By the Boys Bakery is a <strong>home-based micro bakery</strong> in
      Germantown, TN. James bakes cookies and desserts in small batches, fresh
      every time.
    </p>
    <a href="/inquiry" class="hero-cta">Submit an Inquiry</a>
    <p class="hero-note">Not sure yet? Tell us the occasion and we'll figure it out.</p>
  </div>

  <!-- Right: image -->
  <div class="hero-right">
    <LocalImg fill src="/_emdash/api/media/file/01KYT23FK5RZNZZ8P5Z8XS9HFY.jpg" alt="Fresh baked cookies" />
    <div class="sticker sticker-1">Home Baked<br />with Love</div>
    <div class="sticker sticker-2">Small Batch<br />From Scratch</div>
  </div>
</section>

<style>
  /* ── Desktop ── */
  .hero {
    min-height: calc(100vh - 74px);
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .hero-left {
    background: var(--color-butter);
    border-right: 4px solid var(--color-choco);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 5rem 3.5rem 5rem 4rem;
  }

  .hero-location-pill {
    display: inline-flex;
    align-items: center;
    background: var(--color-choco);
    color: var(--color-butter);
    padding: 0.45rem 1rem;
    border-radius: 100px;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    margin-bottom: 1.75rem;
    width: fit-content;
  }

  .hero-title {
    font-family: var(--font-family-display);
    font-size: clamp(3rem, 5vw, 5.5rem);
    line-height: 1.1;
    color: var(--color-choco);
    margin-bottom: 1.5rem;
  }

  .hero-title .red { color: var(--color-strawberry); }

  .hero-desc {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-muted);
    line-height: 1.75;
    max-width: 400px;
    margin-bottom: 2.5rem;
  }

  .hero-desc strong {
    color: var(--color-choco);
    font-weight: 900;
  }

  .hero-cta {
    display: inline-block;
    background: var(--color-strawberry);
    color: #fff;
    border: 3px solid var(--color-choco);
    box-shadow: var(--shadow-neo);
    padding: 1rem 2.25rem;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 900;
    text-decoration: none;
    transition: transform 0.15s, box-shadow 0.15s;
    width: fit-content;
  }

  .hero-cta:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-neo-lg);
  }

  .hero-note {
    margin-top: 1.25rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-muted);
  }

  /* Right panel */
  .hero-right {
    position: relative;
    overflow: hidden;
    background: var(--color-sky);
  }

  .sticker {
    position: absolute;
    background: #fff;
    border: 3px solid var(--color-choco);
    box-shadow: var(--shadow-neo);
    border-radius: 16px;
    padding: 0.75rem 1rem;
    font-weight: 900;
    font-size: 0.85rem;
    color: var(--color-choco);
    line-height: 1.3;
    text-align: center;
  }

  .sticker-1 {
    top: 2rem;
    right: 2rem;
    background: var(--color-mint);
    transform: rotate(5deg);
  }

  .sticker-2 {
    bottom: 2rem;
    left: 2rem;
    background: var(--color-butter);
    transform: rotate(-4deg);
  }

  /* ── Tablet ── */
  @media (max-width: 1023px) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr 1fr;
    }

    .hero-left {
      padding: 3.5rem 2.5rem;
    }

    .hero-title {
      font-size: clamp(2.5rem, 4.5vw, 4rem);
    }
  }

  /* ── Mobile ── */
  @media (max-width: 767px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .hero-left {
      border-right: none;
      border-bottom: 4px solid var(--color-choco);
      padding: 2.5rem 1.5rem;
      align-items: flex-start;
    }

    .hero-title {
      font-size: clamp(2.25rem, 9vw, 3rem);
    }

    .hero-desc {
      font-size: 0.95rem;
      max-width: 100%;
    }

    /* Image panel: fixed height on mobile instead of fill */
    .hero-right {
      height: 300px;
    }

    .sticker {
      font-size: 0.75rem;
      padding: 0.6rem 0.8rem;
    }

    .sticker-1 { top: 1rem; right: 1rem; }
    .sticker-2 { bottom: 1rem; left: 1rem; }
  }
</style>
