---
import { Image } from "emdash/ui";
import type { MediaValue } from "emdash";

interface Props {
  title?: string;
  titleAccent?: string;
  desc?: string;
  ctaLabel?: string;
  ctaHref?: string;
  note?: string;
  image?: MediaValue;
  edit?: Record<string, Record<string, unknown>>;
}

const {
  title = "Homemade treats from",
  titleAccent = "the boys!",
  desc = "By the Boys Bakery is a home-based micro bakery in Germantown, TN. James bakes cookies and desserts in small batches, fresh every time.",
  ctaLabel = "Submit an Inquiry",
  ctaHref = "/inquiry",
  note = "Not sure yet? Tell us the occasion and we'll figure it out.",
  image,
  edit = {},
} = Astro.props;
---

<section class="hero">
  <!-- Left: content -->
  <div class="hero-left">
    <h1 class="hero-title">
      <span {...edit.hero_title}>{title}</span>{" "}
      <span class="red" {...edit.hero_title_accent}>{titleAccent}</span>
    </h1>
    <p class="hero-desc" {...edit.hero_desc}>{desc}</p>
    <a href={ctaHref} class="hero-cta" {...edit.hero_cta_label}>{ctaLabel}</a>
    <p class="hero-note" {...edit.hero_note}>{note}</p>
  </div>

  <!-- Right: image -->
  <div class="hero-right" {...edit.hero_image}>
    {image && (
      <Image image={image} alt={image?.alt ?? "Fresh baked treats"} class="hero-img" priority />
    )}
  </div>
</section>

<style>
  /* ── Desktop ── */
  .hero {
    min-height: calc(100vh - var(--site-header-height));
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .hero-left {
    background: var(--color-cream);
    border-right: var(--border-width) solid var(--color-choco);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 5rem 3.5rem 5rem 4rem;
  }

  .hero-title {
    font-family: var(--font-family-display);
    font-size: clamp(3rem, 5vw, 5.5rem);
    line-height: 1.1;
    color: var(--color-choco);
    margin-bottom: 1.5rem;
  }

  .hero-title .red { color: var(--color-choco); text-decoration: underline; text-decoration-color: var(--color-coral); text-decoration-thickness: 0.08em; text-underline-offset: 0.1em; }

  .hero-desc {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-muted);
    line-height: 1.75;
    max-width: 400px;
    margin-bottom: 2.5rem;
  }

  .hero-desc strong {
    color: var(--color-choco);
    font-weight: 900;
  }

  .hero-cta {
    display: inline-block;
    background: var(--color-coral);
    color: var(--action-primary-text);
    border: var(--border-width) solid var(--color-choco);
    box-shadow: var(--shadow-neo);
    padding: 1rem 2.25rem;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.15s, box-shadow 0.15s;
    width: fit-content;
  }

  .hero-cta:hover {
    background: var(--action-primary-hover-bg);
    color: var(--action-primary-hover-text);
    transform: none;
    box-shadow: var(--shadow-neo-lg);
  }

  .hero-note {
    margin-top: 1.25rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-muted);
  }

  /* Right panel */
  .hero-right {
    position: relative;
    overflow: hidden;
    background: var(--color-cream);
  }

  /* Image component renders in a child component, so the class it's given
     lands outside this file's scoped styles — use :global to reach it. */
  :global(.hero-img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Tablet ── */
  @media (max-width: 1023px) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr 1fr;
    }

    .hero-left {
      padding: 3.5rem 2.5rem;
    }

    .hero-title {
      font-size: clamp(2.5rem, 4.5vw, 4rem);
    }
  }

  /* ── Mobile ── */
  @media (max-width: 767px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .hero-left {
      border-right: none;
      border-bottom: var(--border-width) solid var(--color-choco);
      padding: 2.5rem 1.5rem;
      align-items: flex-start;
    }

    .hero-title {
      font-size: clamp(2.25rem, 9vw, 3rem);
    }

    .hero-desc {
      font-size: 0.95rem;
      max-width: 100%;
    }

    /* Image panel: fixed height on mobile instead of fill */
    .hero-right {
      height: 300px;
    }
  }
</style>
