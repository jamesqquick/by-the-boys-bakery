---
import { sanitizeHref } from "emdash";
import type { PricingItem, PricingOption, PricingPage } from "../../../.emdash/types";

type EditableEntry<T> = {
  data: T;
  edit: Record<string, Record<string, unknown>>;
};

type PricingPageContent = Pick<PricingPage, "title"> &
  Partial<
    Pick<
      PricingPage,
      | "eyebrow"
      | "description"
      | "cta_label"
      | "cta_href"
      | "list_title"
      | "list_note"
      | "closing_note"
    >
  >;

interface Props {
  page?: PricingPageContent;
  pageEdit?: Record<string, Record<string, unknown>>;
  pricingItems?: EditableEntry<PricingItem>[];
  pricingOptions?: EditableEntry<PricingOption>[];
}

const {
  page: pageProp,
  pageEdit = {},
  pricingItems = [],
  pricingOptions = [],
} = Astro.props;
const page = pageProp ?? {
  eyebrow: "The Good Stuff",
  title: "Simple prices.",
  description: "Pricing is being updated. Send us the details and we will help you plan your order.",
  cta_label: "Start an Inquiry",
  cta_href: "/inquiry",
  list_title: "Pick a favorite",
};
const ctaHref = sanitizeHref(page.cta_href);
const hasCtaLink = Boolean(page.cta_href && ctaHref !== "#");
const listTitle = page.list_title || "Pricing";
const optionsByItem = new Map<string, EditableEntry<PricingOption>[]>();

for (const option of pricingOptions) {
  const itemOptions = optionsByItem.get(option.data.item) ?? [];
  itemOptions.push(option);
  optionsByItem.set(option.data.item, itemOptions);
}

const priceFormatter = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
  minimumFractionDigits: 0,
  maximumFractionDigits: 2,
});
---

<section id="pricing" class="pricing-layout" aria-labelledby="pricing-title">
  <div class="pricing-intro">
    {page.eyebrow && (
      <span class="pricing-eyebrow" {...pageEdit.eyebrow}>{page.eyebrow}</span>
    )}
    <h2 id="pricing-title" {...pageEdit.title}>{page.title}</h2>
    {page.description && <p {...pageEdit.description}>{page.description}</p>}
    {page.cta_label && hasCtaLink && (
      <a
        href={ctaHref}
        class="btn btn-secondary pricing-cta"
        {...pageEdit.cta_href}
      >
        <span {...pageEdit.cta_label}>{page.cta_label}</span>
      </a>
    )}
  </div>

  <div class="pricing-list" aria-labelledby="pricing-heading">
    <div class="pricing-list-header">
      <h3 id="pricing-heading" {...pageEdit.list_title}>{listTitle}</h3>
      {page.list_note && <span {...pageEdit.list_note}>{page.list_note}</span>}
    </div>

    {pricingItems.length > 0 ? (
      pricingItems.map((item) => {
        const itemOptions = optionsByItem.get(item.data.id) ?? [];
        const hasLabeledOptions = itemOptions.some((option) => option.data.label);

        return (
          <article class="pricing-item">
            <h4 {...item.edit.title}>{item.data.title}</h4>
            <div class="pricing-item-copy">
              {item.data.subtitle && (
                <strong {...item.edit.subtitle}>{item.data.subtitle}</strong>
              )}
              {item.data.description && (
                <p {...item.edit.description}>{item.data.description}</p>
              )}
            </div>
            {itemOptions.length > 0 ? (
              <div
                class:list={[
                  "price",
                  { "price-options": itemOptions.length > 1 || hasLabeledOptions },
                ]}
              >
                {itemOptions.map((option) => (
                  <span>
                    {option.data.label && (
                      <strong {...option.edit.label}>{option.data.label}</strong>
                    )}
                    <span {...option.edit.amount}>
                      {priceFormatter.format(option.data.amount)}
                    </span>
                  </span>
                ))}
              </div>
            ) : hasCtaLink ? (
              <a
                href={ctaHref}
                class="price price-inquiry"
                aria-label={`Ask us about ${item.data.title}`}
              >Ask us</a>
            ) : (
              <span class="price price-inquiry">Ask us</span>
            )}
          </article>
        );
      })
    ) : (
      <div class="pricing-empty">
        <h4>Planning something sweet?</h4>
        <p>Pricing is being updated. Send us the details and we will help you plan your order.</p>
        {page.cta_label && hasCtaLink && (
          <a href={ctaHref} class="btn btn-secondary" {...pageEdit.cta_href}>
            <span {...pageEdit.cta_label}>{page.cta_label}</span>
          </a>
        )}
      </div>
    )}

    {page.closing_note && (
      <p class="pricing-note" {...pageEdit.closing_note}>{page.closing_note}</p>
    )}
  </div>
</section>

<style>
  .pricing-layout {
    display: grid;
    grid-template-columns: minmax(320px, 0.78fr) minmax(0, 1.22fr);
    min-height: calc(100vh - 77px);
    border-top: 4px solid var(--color-choco);
    scroll-margin-top: 5rem;
  }

  .pricing-intro {
    position: sticky;
    top: 77px;
    align-self: start;
    min-height: calc(100vh - 77px);
    padding: 6rem 4rem;
    background: var(--color-strawberry);
    border-right: 3px solid var(--color-choco);
  }

  .pricing-eyebrow {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0.3rem 0.85rem;
    background: var(--color-butter);
    border: 3px solid var(--color-choco);
    border-radius: var(--radius-pill);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pricing-intro h2 {
    margin: 1.2rem 0 1.5rem;
    color: var(--color-cream);
    font-size: clamp(4rem, 8vw, 7.5rem);
  }

  .pricing-intro p {
    max-width: 620px;
    color: var(--color-choco);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.7;
  }

  .pricing-cta {
    margin-top: 2rem;
    background: var(--color-cream);
  }

  .pricing-list {
    padding: 3rem 4rem 5rem;
    background-color: var(--color-cream);
    background-image: radial-gradient(rgba(61, 31, 10, 0.11) 1.2px, transparent 1.2px);
    background-size: 18px 18px;
  }

  .pricing-list-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.4rem;
    border-bottom: 3px solid var(--color-choco);
  }

  .pricing-list-header h3 {
    font-size: 2.3rem;
  }

  .pricing-list-header > span {
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pricing-item {
    display: grid;
    grid-template-columns: minmax(180px, 0.65fr) minmax(0, 1.35fr) auto;
    gap: 2rem;
    align-items: start;
    padding: 2.6rem 0;
    border-bottom: 3px solid var(--color-choco);
  }

  .pricing-item h4 {
    font-size: clamp(1.9rem, 3vw, 2.8rem);
  }

  .pricing-item-copy {
    max-width: 52ch;
  }

  .pricing-item-copy > strong {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--color-choco);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .pricing-item-copy p {
    font-weight: 700;
  }

  .price {
    min-width: 104px;
    padding: 0.8rem 1rem;
    background: var(--color-butter);
    border: 3px solid var(--color-choco);
    border-radius: 15px;
    box-shadow: var(--shadow-neo);
    font-size: 1.4rem;
    font-weight: 900;
    line-height: 1;
    text-align: center;
    transform: rotate(2deg);
  }

  .price-options {
    display: grid;
    gap: 0.6rem;
    min-width: 150px;
    font-size: 1rem;
    transform: rotate(-1deg);
  }

  .price-options > span {
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .price-options strong {
    font-weight: 900;
  }

  .price-inquiry {
    color: var(--color-choco);
    font-size: 1rem;
    text-decoration: none;
  }

  .pricing-note {
    margin-top: 2.5rem;
    padding: 1.5rem;
    background: var(--color-sky);
    border: 3px solid var(--color-choco);
    border-radius: 18px;
    box-shadow: var(--shadow-neo);
    font-weight: 800;
  }

  .pricing-empty {
    margin-top: 2.5rem;
    padding: 2rem;
    background: var(--color-sky);
    border: 3px solid var(--color-choco);
    border-radius: 18px;
    box-shadow: var(--shadow-neo);
  }

  .pricing-empty h4 {
    font-size: 2rem;
  }

  .pricing-empty p {
    margin: 0.75rem 0 1.5rem;
    font-weight: 700;
  }

  @media (max-width: 1100px) {
    .pricing-intro {
      padding: 5rem 2.5rem;
    }

    .pricing-list {
      padding-inline: 2.5rem;
    }

    .pricing-item {
      grid-template-columns: 1fr auto;
    }

    .pricing-item-copy {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  @media (max-width: 860px) {
    .pricing-layout {
      grid-template-columns: 1fr;
    }

    .pricing-intro {
      position: static;
      min-height: auto;
      padding: 4rem 1.5rem;
      border-right: 0;
      border-bottom: 3px solid var(--color-choco);
    }

    .pricing-intro h2 {
      font-size: clamp(3.8rem, 19vw, 5.5rem);
    }

    .pricing-list {
      padding: 3rem 1.5rem;
    }

    .pricing-item {
      grid-template-columns: 1fr auto;
      gap: 1.3rem;
    }

    .pricing-item-copy {
      grid-column: 1 / -1;
    }

    .price-options {
      min-width: 136px;
    }
  }

  @media (max-width: 430px) {
    .pricing-list-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .pricing-item {
      grid-template-columns: 1fr;
    }

    .price,
    .price-options {
      grid-row: 2;
      width: fit-content;
    }

    .pricing-item-copy {
      grid-row: 3;
    }
  }
</style>
