---
import { Image } from "emdash/ui";
import type { MediaValue } from "emdash";

interface Props {
  title?: string;
  titleAccent?: string;
  intro?: string;
  list?: unknown;
  outro?: string;
  image?: MediaValue;
  edit?: Record<string, Record<string, unknown>>;
}

const {
  title = "James & the",
  titleAccent = "Boys!",
  intro = "Hi, I'm James. I live in Germantown, TN and I love baking. Every weekend my three nephews and I get in the kitchen together and make something good.\n\nWe call them the boys. They show up every Saturday, and before long neighbors started asking where the food was coming from.",
  list: listRaw,
  outro = "By the Boys Bakery started because good food is worth sharing. We'd love to bake something for you.",
  image,
  edit = {},
} = Astro.props;

const fallbackList = [
  "100% homemade, baked in our own kitchen",
  "Small batches so every treat gets real attention",
  "Made-to-order, never sitting on a shelf",
  "Right here in Germantown, TN",
];
const list =
  Array.isArray(listRaw) && listRaw.length > 0 ? (listRaw as string[]) : fallbackList;
const introParagraphs = (intro ?? "")
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
---

<section id="about" class="about">
  <!-- Image side -->
  <div class="about-img-wrap">
    {image ? (
      <div class="about-img" {...edit.about_image}>
        <Image image={image} alt={image?.alt ?? "James and the boys baking"} class="about-img-media" />
      </div>
    ) : (
      <div class="about-img about-img--empty" {...edit.about_image}></div>
    )}
  </div>

  <!-- Content side -->
  <div class="about-content">
    <h2 class="about-title">
      <span {...edit.about_title}>{title}</span>{" "}
      <span class="pop" {...edit.about_title_accent}>{titleAccent}</span>
    </h2>
    {introParagraphs.length > 0 && (
      <div {...edit.about_intro}>
        {introParagraphs.map((p) => <p>{p}</p>)}
      </div>
    )}
    <ul class="about-list">
      {list.map((item) => <li>{item}</li>)}
    </ul>
    <p {...edit.about_outro}>{outro}</p>
  </div>
</section>

<style>
  /* ── Desktop ── */
  .about {
    background: var(--color-cream);
    border-bottom: var(--border-width) solid var(--color-choco);
    padding: 7rem 4rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .about-img {
    aspect-ratio: 4/5;
    border-radius: var(--radius-card);
    border: var(--border-width) solid var(--color-choco);
    box-shadow: var(--shadow-neo);
    overflow: hidden;
  }

  .about-img--empty {
    background: var(--color-cream);
  }

  /* Image component renders in a child component, so the class it's given
     lands outside this file's scoped styles — use :global to reach it. */
  :global(.about-img-media) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-title {
    font-family: var(--font-family-display);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    color: var(--color-choco);
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }

  .about-title .pop { color: var(--color-choco); text-decoration: underline; text-decoration-color: var(--color-coral); text-decoration-thickness: 0.08em; text-underline-offset: 0.1em; }

  .about-content p {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.8;
    color: var(--color-choco);
    margin-bottom: 1.1rem;
  }

  .about-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .about-list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--color-choco);
  }

  .about-list li::before {
    content: "";
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-coral);
    border: 2px solid var(--color-choco);
    flex-shrink: 0;
  }

  /* ── Tablet ── */
  @media (max-width: 1023px) {
    .about {
      padding: 5rem 2.5rem;
      gap: 3rem;
    }
  }

  /* ── Mobile ── */
  @media (max-width: 767px) {
    .about {
      grid-template-columns: 1fr;
      padding: 3rem 1.5rem 3.5rem;
      gap: 2.5rem;
    }

    /* Image comes second (content first) on mobile */
    .about-content { order: -1; }

    .about-img-wrap {
      max-width: 420px;
      margin: 0 auto;
      width: 100%;
    }

    .about-img {
      /* Use landscape ratio on mobile so it doesn't take up huge height */
      aspect-ratio: 3/2 !important;
    }

    .about-title {
      font-size: clamp(2rem, 8vw, 2.75rem);
      margin-bottom: 1rem;
    }
  }
</style>
