---
// Preview-only image component. Mirrors PlaceholderImg's API so it can be
// dropped in without touching layout. Swap back to CMS media in Phase 2.
interface Props {
  src: string;
  aspectRatio?: string;
  alt?: string;
  class?: string;
  /** When true the element is position:absolute inset-0, filling its positioned parent. */
  fill?: boolean;
}

const {
  src,
  aspectRatio = "4/3",
  alt = "",
  class: className,
  fill = false,
} = Astro.props;
---

<div
  class:list={["local-img", className, { "local-img--fill": fill }]}
  style={fill ? undefined : `aspect-ratio: ${aspectRatio}`}
>
  <img src={src} alt={alt} loading="lazy" decoding="async" />
</div>

<style>
  .local-img {
    width: 100%;
    overflow: hidden;
  }

  .local-img--fill {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .local-img img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
