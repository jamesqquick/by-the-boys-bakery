				},
				{
					"type": "custom",
					"label": "Posts",
					"url": "/posts"
				},
				{
					"type": "custom",
					"label": "About",
					"url": "/about"
				}
			]
		}
	],
	"widgetAreas": [
		{
			"name": "sidebar",
			"label": "Sidebar",
			"description": "Sidebar widget area",
			"widgets": [
				{
					"type": "component",
					"componentId": "core:search",
					"title": "Search"
				},
				{
					"type": "component",
					"componentId": "core:categories",
					"title": "Categories"
				},
				{
					"type": "component",
					"componentId": "core:recent-posts",
					"title": "Recent Posts",
					"settings": {
						"count": 5
					}
				}
			]
		}
	],
	"content": {
		"pages": [
			{
				"id": "about",
				"slug": "about",
				"status": "published",
				"data": {
					"title": "About",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "By the Boys Bakery is a home-based micro bakery run out of Germantown, TN. We bake cookies, brownies, cupcakes, and cakes in small batches — made to order, not mass-produced.",
									"_key": "k1"
								}
							],
							"_key": "k0"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Every order is baked fresh for your occasion. We take custom orders for birthdays, holidays, office events, and everything in between.",
									"_key": "k3"
								}
							],
							"_key": "k2"
						},
						{
							"_type": "block",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "How to order",
									"_key": "k5"
								}
							],
							"_key": "k4"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Fill out our inquiry form and we'll get back to you within 48 hours. We need at least 5–7 days notice to plan and bake your order.",
									"_key": "k7"
								}
							],
							"_key": "k6"
						}
					]
				}
			}
		],
		"posts": [
			{
				"id": "post-1",
				"slug": "welcome",
				"status": "published",
				"data": {
					"title": "We're Open for Orders",
					"excerpt": "By the Boys Bakery is now taking custom orders for cookies, brownies, cupcakes, and cakes in Germantown, TN.",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "We're officially open and taking orders! Whether you need a dozen cookies for a birthday, a tray of brownies for the office, or cupcakes for a baby shower — we've got you.",
									"_key": "k1"
								}
							],
							"_key": "k0"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Everything is baked fresh, in small batches, made to order. No preservatives, no sitting on a shelf. Just good stuff made with care.",
									"_key": "k3"
								}
							],
							"_key": "k2"
						},
						{
							"_type": "block",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "How to place an order",
									"_key": "k5"
								}
							],
							"_key": "k4"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Head to the inquiry page, fill out the form, and we'll get back to you within 48 hours. We ask for at least 5–7 days notice so we can plan and bake everything fresh.",
									"_key": "k7"
								}
							],
							"_key": "k6"
						}
					]
				},
				"taxonomies": {
					"category": ["general"],
					"tag": ["starter", "example"]
				}
			}
		]
	}
}
