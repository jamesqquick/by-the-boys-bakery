								}
							],
							"_key": "k0"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Everything is baked fresh, in small batches, made to order. No preservatives, no sitting on a shelf. Just good stuff made with care.",
									"_key": "k3"
								}
							],
							"_key": "k2"
						},
						{
							"_type": "block",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "How to place an order",
									"_key": "k5"
								}
							],
							"_key": "k4"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Head to the inquiry page, fill out the form, and we'll get back to you within 48 hours. We ask for at least 5–7 days notice so we can plan and bake everything fresh.",
									"_key": "k7"
								}
							],
							"_key": "k6"
						}
					]
				},
