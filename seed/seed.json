						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Fill out our inquiry form and we'll get back to you within 48 hours. We need at least 5–7 days notice to plan and bake your order.",
									"_key": "k7"
								}
							],
							"_key": "k6"
						}
					]
