{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "by-the-boys-bakery",
	"workers_dev": false,
	"account_id": "4426cbeacb457b1ca1b865d6c36ced0d",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "by-the-boys-bakery",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "by-the-boys-bakery-media",
		},
	],
	"send_email": [
		{
			"name": "EMAIL",
			// remote: true sends real emails in local dev via wrangler dev.
			// Remove or set to false to simulate locally (logs only, nothing sent).
			"remote": true,
		},
	],
	// Drives scheduled publishing, plugin cron, and maintenance (see src/worker.ts)
	"triggers": {
		"crons": ["* * * * *"],
	},
}
